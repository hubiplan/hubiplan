"unbekannte Nummer)."
msgstr ""
"Not found or not allowed (“Website” module off, permission missing or "
"unknown number)."

msgid "Das hat nicht geklappt (Fehler {status})."
msgstr "That did not work (error {status})."

msgid "„%(name)s“ muss eine Nummer sein."
msgstr "“%(name)s” must be a number."

msgid "„%(name)s“ ist zu lang (höchstens %(limit)s Zeichen)."
msgstr "“%(name)s” is too long (at most %(limit)s characters)."

msgid ""
