#, python-brace-format
msgid ""
"Guten Tag,\n"
"\n"
"{first_name} {last_name} wird am {day} volljährig. Ab dann endet bei {club} Ihr Zugang als Erziehungsberechtigte bzw. Erziehungsberechtigter, und Ihre Kontaktangaben werden beim Mitglied gelöscht. Einwilligungen, die Sie gegeben haben, gelten weiter, bis das Mitglied sie widerruft.\n"
"\n"
"Das Mitglied kann danach einen eigenen Zugang bekommen.\n"
"\n"
"Viele Grüße\n"
"{club}\n"
msgstr ""
"Hello,\n"
"\n"
"{first_name} {last_name} turns 18 on {day}. From then on, your access as a guardian at {club} ends and your contact details are removed from the member's record. Consents you have given remain valid until the member withdraws them.\n"
"\n"
"The member can then get their own access.\n"
"\n"
"Kind regards\n"
"{club}\n"

msgid ""
"Bitte erteilen Sie dem Verein ein Lastschriftmandat oder überweisen Sie den "
"Beitrag künftig selbst.\n"
msgstr ""
"Please give the club a direct debit mandate or transfer the fee yourself "
"from now on.\n"

msgid "{company} zahlt nicht mehr für {name}"
msgstr "{company} no longer pays for {name}"

msgid ""
"{company} zahlt den Mitgliedsbeitrag für {name} nur noch bis {day}. Die "
"Mitgliedschaft bleibt bestehen; danach zahlt das Mitglied selbst.\n"
msgstr ""
"{company} pays the membership fee for {name} only until {day}. The "
"membership continues; afterwards the member pays themselves.\n"

msgid "Das Datum liegt in der Vergangenheit."
msgstr "The date is in the past."

msgid ""
"Der Verein hat keinen Online-Antrag eingeschaltet. Bitte meldet Mitarbeiter "
"direkt beim Verein."
msgstr ""
"The club has not enabled an online application. Please report employees "
"directly to the club."

msgid "Mitgliedsantrag bei {club}"
msgstr "Membership application at {club}"

msgid ""
"Guten Tag {first_name} {last_name},\n"
"\n"
"{company} hat Sie bei {club} als Mitglied angemeldet und zahlt Ihren Mitgliedsbeitrag. Bitte ergänzen Sie Ihre Angaben im Online-Antrag und bestätigen Sie ihn per Mail:\n"
"\n"
"{url}\n"
"\n"
"Der Link gilt {days} Tage. Möchten Sie nicht Mitglied werden, müssen Sie nichts tun.\n"
"\n"
"Viele Grüße\n"
"{club}\n"
msgstr ""
"Hello {first_name} {last_name},\n"
"\n"
"{company} has registered you as a member of {club} and pays your membership fee. Please complete your details in the online application and confirm it by email:\n"
"\n"
"{url}\n"
"\n"
"The link is valid for {days} days. If you do not want to become a member, you do not need to do anything.\n"
"\n"
"Kind regards\n"
"{club}\n"

msgid ""
"Der Link der Firma ist abgelaufen. Bitte bei der Firma einen neuen "
"anfordern."
msgstr "The company link has expired. Please ask the company for a new one."

msgid ""
"Dieser Link gilt nur für die Mailadresse, an die er geschickt wurde. Bitte "
"diese Adresse angeben oder bei der Firma einen neuen Link anfordern."
msgstr ""
"This link is only valid for the email address it was sent to. Please enter "
"that address or ask the company for a new link."

msgid ""
"Bitte nur Buchstaben, Leerzeichen, Bindestrich, Punkt und Apostroph."
msgstr "Please use only letters, spaces, hyphens, full stops and apostrophes."

msgid ""
"An diese Adresse ging heute schon eine Meldung. Bitte morgen erneut."
msgstr ""
"A report has already been sent to this address today. Please try again "
"tomorrow."

msgid ""
"Heute wurden schon sehr viele Mitarbeiter gemeldet. Bitte morgen erneut oder "
"direkt beim Verein melden."
msgstr ""
"A large number of employees have already been reported today. Please try "
"again tomorrow or contact the club directly."

msgid "Beitrag zahlt"
msgstr "Fee paid by"

msgid "Der Haushalt hat keinen Zahler mehr."
msgstr "The household no longer has a payer."

msgid ""
"Rolle im Haushalt: „{value}“ ist unbekannt (erlaubt: Erwachsener, Kind oder "
"leer)."
msgstr ""
"Role in household: “{value}” is unknown (allowed: Erwachsener, Kind or "
"empty)."

msgid ""
"Beitrag über: „{value}“ ist unbekannt (erlaubt: Haushalt, Firma oder leer)."
msgstr "Fee via: “{value}” is unknown (allowed: Haushalt, Firma or empty)."

msgid "Beitrag über {value}: Spalte „{column}“ ist leer."
msgstr "Fee via {value}: column “{column}” is empty."

msgid ""
"Weitere Familienmitglieder kann nur eine volljährige Person mit beantragen."
msgstr "Only an adult can apply for further family members."

msgid "Höchstens {n} weitere Personen."
msgstr "At most {n} further people."

msgid "Weitere Person"
msgstr "Further person"

msgid "Kündigung"
msgstr "Cancellation"

#, python-brace-format
msgid "kündigt zum {date}"
msgstr "cancels as of {date}"

msgid "zu jedem Tag"
msgstr "on any day"

msgid "zum Monatsende"
msgstr "at the end of a month"

msgid "zum Quartalsende"
msgstr "at the end of a quarter"

msgid "zum Halbjahresende"
msgstr "at the end of a half-year"

msgid "zum Ende des Geschäftsjahres"
msgstr "at the end of the financial year"

#, python-brace-format
msgid "ohne Frist {end}"
msgstr "without notice {end}"

#, python-brace-format
msgid "mit einer Frist von einem Monat {end}"
msgstr "with one month’s notice {end}"

#, python-brace-format
msgid "mit einer Frist von {months} Monaten {end}"
msgstr "with {months} months’ notice {end}"

#, python-brace-format
msgid "{org} hat Ihre Kündigung der Mitgliedschaft erhalten. Gewünschter Austritt: {date}."
msgstr "{org} has received your cancellation of membership. Requested leaving date: {date}."

msgid "Der Verein prüft die Kündigung und bestätigt sie Ihnen. Bis dahin können Sie sie im Mitgliederbereich unter „Meine Daten“ zurücknehmen."
msgstr "The club will check the cancellation and confirm it to you. Until then you can withdraw it in the members’ area under “My data”."

#, python-brace-format
msgid "Kündigung eingegangen – {org}"
msgstr "Cancellation received – {org}"

#, python-brace-format
msgid "Austrittsbestätigung – {org}"
msgstr "Confirmation of leaving – {org}"

#, python-brace-format
msgid "{org} bestätigt Ihren Austritt zum {date}. Bis dahin bleiben Sie Mitglied."
msgstr "{org} confirms that you leave on {date}. You remain a member until then."

#, python-brace-format
msgid "Kündigung nicht bestätigt – {org}"
msgstr "Cancellation not confirmed – {org}"

#, python-brace-format
msgid "{org} hat Ihre Kündigung vom {date} nicht bestätigt. Ihre Mitgliedschaft läuft weiter."
msgstr "{org} has not confirmed your cancellation of {date}. Your membership continues."

#, python-brace-format
msgid "Nachricht des Vereins: {text}"
msgstr "Message from the club: {text}"

#, python-brace-format
msgid "Frühestens zum {date} ({rule})."
msgstr "{date} at the earliest ({rule})."

#, python-brace-format
msgid "Bitte ein Datum bis zum {date} wählen."
msgstr "Please choose a date up to {date}."

msgid "Kündigen im Mitgliederbereich ist in diesem Verein nicht eingeschaltet."
msgstr "Cancelling in the members’ area is not switched on for this club."

msgid "Für deine Mitgliedschaft ist schon ein Austritt eingetragen."
msgstr "A leaving date is already recorded for your membership."

msgid "Deine Kündigung liegt dem Verein schon vor."
msgstr "The club already has your cancellation."

msgid "Diese Kündigung ist schon bearbeitet."
msgstr "This cancellation has already been processed."

msgid "Deine Kündigung wurde bestätigt"
msgstr "Your cancellation was confirmed"

msgid "Deine Kündigung wurde nicht bestätigt"
msgstr "Your cancellation was not confirmed"

msgid "zurückgenommen"
msgstr "withdrawn"

msgid "Bitte bestätige, dass du kündigen möchtest."
msgstr "Please confirm that you want to cancel."

msgid "Abschnittsarten und Auswahl"
msgstr "Section types and choices"

msgid ""
"Arten eigener Abschnitte mit ihren Feldern und die Nummern, auf die sie "
"verweisen können (Rollen, Alben, Termine, Orte, Kategorien, Dokumente). "
"Bilder: webseite_bilder."
msgstr ""
"Types of custom sections with their fields and the numbers they can refer "
"to (roles, albums, events, places, categories, documents). Images: "
"webseite_bilder."

msgid "Aufbau der Startseite geändert."
msgstr "Home page layout changed."

msgid "Aufbau der Startseite ändern (Entwurf)"
msgstr "Change home page layout (draft)"

msgid "Bereich → Variante oder null."
msgstr "Area → variant or null."

msgid ""
"Beschreibe nur, was zu sehen ist. Erkenne oder benenne keine Personen; "
"Namen kommen nur aus HUBIplan."
msgstr ""
"Describe only what can be seen. Do not recognise or name people; names come "
"only from HUBIplan."

msgid "Bild als Nummer {pk} in der Bilderverwaltung gespeichert ({markdown})."
msgstr "Image saved to the media library as number {pk} ({markdown})."

msgid "Bild ansehen"
msgstr "View image"

msgid "Bild beschreiben"
msgstr "Describe image"

msgid "Bild nicht erreichbar: {x}"
msgstr "Image not reachable: {x}"

msgid "Bild von einer Adresse holen"
msgstr "Fetch image from an address"

msgid ""
"Bilder der Webseite (neueste zuerst). Ansehen mit bild_ansehen, Texte dazu "
"mit bild_beschreiben. In Texten mit der Markdown-Zeile einbinden, in "
"Abschnitten mit der Nummer."
msgstr ""
"Website images (newest first). View with bild_ansehen, add texts with "
"bild_beschreiben. Embed in texts with the Markdown line, in sections with "
"the number."

msgid ""
"Bilder der Webseite. In Texten mit der Markdown-Zeile einbinden. Neue "
"Bilder: bild_hochladen_vorbereiten liefert einen Link zum Hochladen."
msgstr ""
"Website images. Embed them in texts with the Markdown line. New images: "
"bild_hochladen_vorbereiten returns an upload link."

msgid "Bilder suchen"
msgstr "Search images"

msgid "Bildnummer oder null (Wappen und Name)."
msgstr "Image number or null (crest and name)."

msgid "Bildunterschrift und Quelle sind zusammen zu lang."
msgstr "Caption and source are too long together."

msgid "Bitte alternativtext oder bildunterschrift angeben."
msgstr "Please give alternativtext or bildunterschrift."

msgid "Bitte angeben, was sich am Aufbau ändern soll."
msgstr "Please say what should change in the layout."

msgid "Bitte angeben, was sich am Menü ändern soll."
msgstr "Please say what should change in the menu."

msgid "Bitte angeben, was sich ändern soll (design, stil, farben, …)."
msgstr "Please say what should change (design, stil, farben, …)."

msgid "Bitte die Server als Liste angeben."
msgstr "Please give the servers as a list."

msgid "Bitte eine vollständige https-Adresse angeben."
msgstr "Please give a complete https address."

msgid "Bitte nur Rechnernamen angeben, z. B. cloud.example.org: {host}"
msgstr "Please give host names only, e.g. cloud.example.org: {host}"

msgid ""
"Das Bild ist schon in Gebrauch und hat einen {name}. Den ändert jemand in "
"HUBIplan unter Webseite › Bilder."
msgstr ""
"The image is already in use and has a {name}. Someone changes it in "
"HUBIplan under Website › Images."

msgid "Das Bild ist schon in Gebrauch; der neue Text gilt dort sofort."
msgstr "The image is already in use; the new text applies there immediately."

msgid "Der Server antwortet mit {status}."
msgstr "The server responds with {status}."

msgid ""
"Design, Farben, Stilregler, Darstellung der Bereiche und Kopfbild im "
"Entwurf, mit allen erlaubten Werten."
msgstr ""
"Design, colours, style controls, area layouts and header image in the "
"draft, with all allowed values."

msgid "Diesen Abschnitt gibt es nicht: {key}"
msgstr "This section does not exist: {key}"

msgid "Dieses Bild gibt es nicht."
msgstr "This image does not exist."

msgid "Ein Link braucht eine „adresse“ mit https://."
msgstr "A link needs an “adresse” with https://."

msgid "Entfernen geht nur bei eigenen Abschnitten: {key}"
msgstr "Only custom sections can be removed: {key}"

msgid ""
"Entwurf {pk} gespeichert. Die Person findet ihn in HUBIplan unter Webseite "
"› Social Media, kopiert Text und Bilder und postet selbst; HUBIplan "
"veröffentlicht nichts bei Instagram oder Facebook."
msgstr ""
"Draft {pk} saved. The person finds it in HUBIplan under Website › Social "
"media, copies text and images and posts it themselves; HUBIplan publishes "
"nothing on Instagram or Facebook."

msgid "Entwürfe für Social-Media-Beiträge, neueste zuerst."
msgstr "Drafts for social media posts, newest first."

msgid ""
"Farbrolle → Palettenplatz, „dark“, „light“, g0, g1 oder null (für das "
"gewählte Design)."
msgstr ""
"Colour role → palette slot, “dark”, “light”, g0, g1 or null (for the chosen "
"design)."

msgid ""
"Gespeichert. Öffentlich wird das Bild erst, wenn es in einem "
"veröffentlichten Text oder Abschnitt steht."
msgstr ""
"Saved. The image only becomes public once it is in a published text or "
"section."

msgid "Gestaltung ansehen"
msgstr "View design"

msgid "Gestaltung geändert ({keys})."
msgstr "Design changed ({keys})."

msgid ""
"Gestaltung im Entwurf. Farben: Palettenplatz (Zahl), „dark“, „light“ oder "
"ein Verlauf (g0, g1, nur wo verlauf_moeglich). Stilregler: Stufe aus "
"stilregler, „switch“ heißt ja/nein, null setzt auf das Design zurück."
msgstr ""
"Design in the draft. Colours: palette slot (number), “dark”, “light” or a "
"gradient (g0, g1, only where verlauf_moeglich). Style controls: level from "
"stilregler, “switch” means yes/no, null resets to the design."

msgid "Gestaltung ändern (Entwurf)"
msgstr "Change design (draft)"

msgid ""
"HUBIplan, eine freie Vereinsverwaltung. Diese Verbindung gilt für genau "
"eine Einheit und darf nie mehr als die Person, die sie erlaubt hat. Die "
"Webseite lässt sich lesen und als Entwurf bearbeiten (Texte, Startseite, "
"Gestaltung, Menü, neue Textseiten). Bilder kommen über einen Hochladelink "
"oder von freigegebenen Servern; Beiträge für soziale Medien werden nur als "
"Entwurf abgelegt. Veröffentlichen, Zustand und Domains gibt es hier nicht; "
"das macht ein Mensch in HUBIplan. Nach Änderungen webseite_vorschau "
"anbieten. Für Fragen zur Bedienung die Hilfe-Werkzeuge nutzen."
msgstr ""
"HUBIplan, a free club management system. This connection applies to exactly "
"one unit and may never do more than the person who allowed it. The website "
"can be read and edited as a draft (texts, home page, design, menu, new text "
"pages). Images come via an upload link or from approved servers; social "
"media posts are only stored as drafts. Publishing, status and domains are "
"not available here; a person does that in HUBIplan. Offer webseite_vorschau "
"after changes. Use the help tools for questions about using HUBIplan."

msgid "Hauptpunkt als Knopf; leer = keiner."
msgstr "Main item shown as a button; empty = none."

msgid ""
"Hauptpunkte in neuer Reihenfolge; fehlende kommen an ihren Standardplatz."
msgstr "Main items in the new order; missing ones go to their default place."

msgid ""
"Holt ein JPG-, PNG- oder WebP-Bild von einem Server, den die Einheit "
"freigegeben hat (Webseite › Internetadresse), in die Bilderverwaltung. Quelle und "
"Lizenz sind Pflicht und kommen in die Bildunterschrift."
msgstr ""
"Fetches a JPG, PNG or WebP image from a server the unit has approved "
"(Website › Web address) into the media library. Source and licence are required "
"and go into the caption."

msgid "Höchstens {n} Server."
msgstr "At most {n} servers."

msgid ""
"Im Entwurf gespeichert. Sichtbar ist es erst, wenn jemand den Entwurf in "
"HUBIplan unter Webseite veröffentlicht. Ansehen mit webseite_vorschau."
msgstr ""
"Saved in the draft. It only becomes visible once someone publishes the "
"draft in HUBIplan under Website. View it with webseite_vorschau."

msgid "Jeder Menüpunkt braucht einen „schluessel“."
msgstr "Every menu item needs a “schluessel”."

msgid ""
"Legt einen Entwurf für Instagram oder Facebook an (Text und Bilder aus der "
"Bilderverwaltung). Gepostet wird von Hand; HUBIplan veröffentlicht nichts "
"bei Meta."
msgstr ""
"Creates a draft for Instagram or Facebook (text and images from the media "
"library). Posting is done by hand; HUBIplan publishes nothing on Meta."

msgid ""
"Liefert einen persönlichen Link (30 Minuten, bis 20 Bilder), über den die "
"Person Fotos in die Bilderverwaltung lädt, ohne sie in den Chat zu geben."
msgstr ""
"Returns a personal link (30 minutes, up to 20 images) through which the "
"person uploads photos to the media library without putting them into the "
"chat."

msgid ""
"Link zum Hochladen (gültig bis {until}, höchstens {n} Bilder): {url}\n"
"\n"
"Gib den Link der Person weiter. Sie öffnet ihn auf Handy oder PC und wählt "
"Fotos; die Dateien gehen nicht über den Chat. Danach findest du die neuen "
"Bilder mit webseite_bilder."
msgstr ""
"Upload link (valid until {until}, at most {n} images): {url}\n"
"\n"
"Pass the link on to the person. They open it on a phone or PC and choose "
"photos; the files do not go through the chat. Afterwards you find the new "
"images with webseite_bilder."

msgid "Link zum Hochladen von Bildern"
msgstr "Link for uploading images"

msgid "Listet die Entwürfe für Social-Media-Beiträge."
msgstr "Lists the drafts for social media posts."

msgid "Menü ansehen"
msgstr "View menu"

msgid ""
"Menü der Webseite im Entwurf: Reihenfolge, Unterpunkte, Namen, Links nach "
"außen und der als Knopf hervorgehobene Punkt."
msgstr ""
"Website menu in the draft: order, sub-items, names, external links and the "
"item highlighted as a button."

msgid "Menü geändert."
msgstr "Menu changed."

msgid ""
"Menü im Entwurf (zwei Ebenen). „an“: Baustein eingeschaltet; ein- und "
"ausschalten geht nur in HUBIplan. Ändern mit webseite_menue_aendern."
msgstr ""
"Menu in the draft (two levels). “an”: block switched on; switching on and "
"off is only possible in HUBIplan. Change with webseite_menue_aendern."

msgid "Menü ändern (Entwurf)"
msgstr "Change menu (draft)"

msgid "Namen höchstens 60 Zeichen."
msgstr "Names at most 60 characters."

msgid "Neue Abschnitte brauchen eine „art“."
msgstr "New sections need an “art”."

msgid "Neue Punkte brauchen einen Namen (höchstens 60 Zeichen)."
msgstr "New items need a name (at most 60 characters)."

msgid "Neue Punkte: art „ueberschrift“ oder „link“ mit name."
msgstr "New items: art “ueberschrift” or “link” with name."

msgid ""
"Neue eigene Abschnitte, Reihenfolge, an/aus, Aussehen und Entfernen eigener "
"Abschnitte im Entwurf. Felder je Art: startseite_bausteine. Braucht das "
"Recht „Webseite verwalten“."
msgstr ""
"New custom sections, order, on/off, look and removal of custom sections in "
"the draft. Fields per type: startseite_bausteine. Needs the “Manage "
"website” permission."

msgid ""
"Ordnet das Menü im Entwurf: Reihenfolge mit Unterpunkten, eigene Namen, "
"neue Überschriften und Links nach außen, Knopf, Platz im Fuß. Bausteine ein- "
"oder ausschalten geht nur in HUBIplan. Braucht das Recht „Webseite "
"verwalten“."
msgstr ""
"Arranges the menu in the draft: order with sub-items, custom names, new "
"headings and external links, button, place in the footer. Switching blocks "
"on or off is only possible in HUBIplan. Needs the “Manage website” "
"permission."

msgid "Quelle: {source}"
msgstr "Source: {source}"

msgid "Schlüssel des Abschnitts davor; leer = ganz oben, fehlt = ganz unten."
msgstr ""
"Key of the section before it; empty = at the top, missing = at the bottom."

msgid "Schlüssel eines Links → https-Adresse."
msgstr "Key of a link → https address."

msgid "Schlüssel → eigener Name; leer = Standardname."
msgstr "Key → custom name; empty = default name."

msgid ""
"Schlüssel → {hintergrund, breite, spalte}, Werte aus startseite_bausteine."
msgstr "Key → {hintergrund, breite, spalte}, values from startseite_bausteine."

msgid ""
"Setzt Alternativtext und/oder Bildunterschrift eines Bildes. Bei Bildern, "
"die schon auf der Webseite stehen, nur, wenn der Text noch fehlt."
msgstr ""
"Sets the alternative text and/or caption of an image. For images already on "
"the website, only if the text is still missing."

msgid "Social-Media-Beitrag entwerfen"
msgstr "Draft social media post"

msgid "Social-Media-Entwürfe"
msgstr "Social media drafts"

msgid "Stilregler → Stufe, ja/nein oder null."
msgstr "Style control → level, yes/no or null."

msgid ""
"Sucht Bilder der Webseite nach Bildunterschrift, Alternativtext, Dateiname "
"und Untereinheit; ohne Suchwort alle."
msgstr ""
"Searches website images by caption, alternative text, file name and "
"sub-unit; without a search term, all of them."

msgid "Texte zu Bild {pk} gespeichert."
msgstr "Texts for image {pk} saved."

msgid "Unter dieser Adresse liegt kein JPG-, PNG- oder WebP-Bild."
msgstr "There is no JPG, PNG or WebP image at this address."

msgid "Urheber und Lizenz, z. B. „Foto: Verein“."
msgstr "Author and licence, e.g. “Photo: club”."

msgid ""
"Von {host} dürfen keine Bilder geholt werden. Erlaubte Server stehen unter "
"Webseite › Internetadresse › Bilder für KI-Assistenten."
msgstr ""
"Images may not be fetched from {host}. Allowed servers are listed under "
"Website › Web address › Images for AI assistants."

msgid ""
"Webseite als Entwurf bearbeiten: Texte, Startseite, Gestaltung und Menü "
"ändern, neue Textseiten anlegen, Bilder hinzufügen und beschreiben, "
"Beiträge für soziale Medien vorbereiten (veröffentlicht wird nur in "
"HUBIplan)"
msgstr ""
"Edit the website as a draft: change texts, home page, design and menu, "
"create new text pages, add and describe images, prepare social media posts "
"(publishing happens only in HUBIplan)"

msgid ""
"Welche eigenen Abschnitte es gibt, welche Felder sie haben und welche "
"Rollen, Alben, Termine, Orte, Kategorien und Dokumente sie zeigen können."
msgstr ""
"Which custom sections exist, which fields they have and which roles, "
"albums, events, places, categories and documents they can show."

msgid ""
"Zeigt ein Bild der Webseite in kleiner Größe, z. B. um einen Alternativtext "
"vorzuschlagen."
msgstr ""
"Shows a website image in a small size, e.g. to suggest an alternative text."

msgid "beliebig"
msgstr "any"

msgid ""
"Ändert Design, Farben, Stilregler, Darstellung oder Kopfbild im Entwurf. "
"Nur angegebene Werte ändern sich; null setzt einen Wert zurück. Werte aus "
"webseite_gestaltung_ansehen. Braucht das Recht „Webseite verwalten“."
msgstr ""
"Changes design, colours, style controls, layout or header image in the "
"draft. Only the given values change; null resets a value. Values from "
"webseite_gestaltung_ansehen. Needs the “Manage website” permission."

msgid "„%(name)s“ muss ein Objekt sein."
msgstr "“%(name)s” must be an object."

msgid "„%(name)s“ muss eine Liste sein."
msgstr "“%(name)s” must be a list."

msgid "„bilder“ ist eine Liste von Bildnummern."
msgstr "“bilder” is a list of image numbers."

msgid "„reihenfolge“ muss eine Liste sein."
msgstr "“reihenfolge” must be a list."

msgid "„bild“ muss eine Bildnummer oder null sein."
msgstr "“bild” must be an image number or null."

msgid "„bilder“ muss eine Liste von Bildnummern sein."
msgstr "“bilder” must be a list of image numbers."

msgid "„bilder_takt“ muss eine Zahl (Sekunden) sein."
msgstr "“bilder_takt” must be a number (seconds)."

msgid "„bilder_zufall“ muss wahr oder falsch sein."
msgstr "“bilder_zufall” must be true or false."

msgid ""
"Hinweis: Bild {numbers} hat noch keinen Alternativtext. Bitte mit "
"bild_beschreiben ergänzen, damit die Seite auch vorgelesen verständlich ist."
msgstr ""
"Note: image {numbers} has no alternative text yet. Please add it with "
"bild_beschreiben so the page is also understandable when read aloud."

msgid ""
"Bilderkarussell der Begrüßung oder einer Untereinheit: Bildnummern in der "
"Reihenfolge (ersetzt die alte Liste, leere Liste entfernt es)."
msgstr ""
"Image carousel of the greeting or of a sub-unit: image numbers in order "
"(replaces the old list, an empty list removes it)."

msgid "Sekunden bis zum nächsten Bild im Karussell."
msgstr "Seconds until the next image in the carousel."

msgid "Karussell mit einem zufälligen Bild beginnen."
msgstr "Start the carousel with a random image."

msgid ""
"Bildnummer aus webseite_bilder für das Bild oben auf der Seite; null "
"entfernt es."
msgstr ""
"Image number from webseite_bilder for the image at the top of the page; null"
" removes it."

msgid "Bitte angeben, was sich am Erscheinungsbild ändern soll."
msgstr "Please say what should change in the appearance."

msgid ""
"Die Einheit hat noch keine eigenen Farben und erbt sie; wer eigene setzt, "
"legt die ganze Palette neu fest."
msgstr ""
"The unit has no colours of its own yet and inherits them; setting its own "
"defines the whole palette anew."

msgid "Erscheinungsbild ansehen"
msgstr "View appearance"

msgid ""
"Erscheinungsbild der Einheit. Platz 0 ist die Hauptfarbe, 1 die Zweitfarbe, "
"2–5 weitere Farben. Farbrollen: text (Fließtext), muted (Sekundärtext), "
"surface (Flächen), background (Seitenhintergrund), jeweils ein "
"Palettenplatz."
msgstr ""
"Appearance of the unit. Slot 0 is the main colour, 1 the second colour, 2–5 "
"further colours. Colour roles: text (body text), muted (secondary text), "
"surface (surfaces), background (page background), each a palette slot."

msgid ""
"Erscheinungsbild geändert ({keys}). Es gilt ab sofort in HUBIplan und auf "
"der Webseite; zurücknehmen lässt es sich im Änderungsprotokoll mit "
"„Rückgängig“."
msgstr ""
"Appearance changed ({keys}). It applies immediately in HUBIplan and on the "
"website; it can be taken back in the change log with “Undo”."

msgid ""
"Erscheinungsbild ändern: Farben, Verläufe, Farbrollen und Logo der Einheit "
"(gilt sofort für HUBIplan und Webseite, rückgängig im Änderungsprotokoll)"
msgstr ""
"Change appearance: colours, gradients, colour roles and logo of the unit "
"(applies immediately to HUBIplan and the website, undo in the change log)"

msgid "Ersetzt alle Verläufe."
msgstr "Replaces all gradients."

msgid "Ersetzt alle weiteren Farben (Plätze 2–5)."
msgstr "Replaces all further colours (slots 2–5)."

msgid ""
"Es gilt ab sofort in HUBIplan und auf der Webseite; das vorherige Logo ist "
"ersetzt."
msgstr ""
"It applies immediately in HUBIplan and on the website; the previous logo "
"has been replaced."

msgid ""
"Farben der Einheit mit Namen und Verwendung, Verläufe, Farbrollen und ob "
"ein Logo gesetzt ist (Einstellungen › Erscheinungsbild)."
msgstr ""
"Colours of the unit with names and use, gradients, colour roles and whether "
"a logo is set (Settings › Appearance)."

msgid "Logo aus einem Bild setzen"
msgstr "Set logo from an image"

msgid "Logo für den Dunkelmodus gesetzt."
msgstr "Logo for dark mode set."

msgid "Logo gesetzt."
msgstr "Logo set."

msgid "Rolle → Palettenplatz; null entfernt."
msgstr "Role → palette slot; null removes it."

msgid ""
"Setzt ein Bild aus der Bilderverwaltung der Webseite als Logo (oder als "
"Logo für den Dunkelmodus). Gilt sofort. Neue Bilder: "
"bild_hochladen_vorbereiten."
msgstr ""
"Sets an image from the website media library as the logo (or as the dark "
"mode logo). Applies immediately. New images: bild_hochladen_vorbereiten."

msgid "Weißen Rand durchsichtig machen."
msgstr "Make the white border transparent."

msgid ""
"Ändert Farben, Namen, Verwendung, weitere Farben, Verläufe und Farbrollen "
"der Einheit. Gilt SOFORT für HUBIplan und Webseite, es gibt keinen Entwurf: "
"vorher die Person fragen. Text auf jeder Farbe muss lesbar sein. Braucht "
"das Recht, das Erscheinungsbild zu bearbeiten."
msgstr ""
"Changes colours, names, use, further colours, gradients and colour roles of "
"the unit. Applies IMMEDIATELY to HUBIplan and the website, there is no "
"draft: ask the person first. Text on every colour must be readable. Needs "
"permission to edit the appearance."

msgid "„farbrollen_in_hubiplan“ ist ja oder nein."
msgstr "“farbrollen_in_hubiplan” is yes or no."

msgid ""
"HUBIplan, eine freie Vereinsverwaltung. Diese Verbindung gilt für genau "
"eine Einheit und darf nie mehr als die Person, die sie erlaubt hat. Die "
"Webseite lässt sich lesen und als Entwurf bearbeiten (Texte, Startseite, "
"Gestaltung, Menü, neue Textseiten). Das Erscheinungsbild (Farben, Verläufe, "
"Logo) lässt sich ändern; das gilt sofort, daher vorher fragen. Bilder "
"kommen über einen Hochladelink oder von freigegebenen Servern; Beiträge für "
"soziale Medien werden nur als Entwurf abgelegt. Veröffentlichen, Zustand "
"und Domains gibt es hier nicht; das macht ein Mensch in HUBIplan. Nach "
"Änderungen webseite_vorschau anbieten. Für Fragen zur Bedienung die "
"Hilfe-Werkzeuge nutzen."
msgstr ""
"HUBIplan, a free club management system. This connection applies to exactly "
"one unit and may never do more than the person who allowed it. The website "
"can be read and edited as a draft (texts, home page, design, menu, new text "
"pages). The appearance (colours, gradients, logo) can be changed; this "
"applies immediately, so ask first. Images come via an upload link or from "
"approved servers; social media posts are only stored as drafts. Publishing, "
"status and domains are not available here; a person does that in HUBIplan. "
"Offer webseite_vorschau after changes. Use the help tools for questions "
"about using HUBIplan."

msgid "Die Anmeldung ist jetzt nicht mehr möglich."
msgstr "Checking in is no longer possible."

msgid "Bei dieser Art ist keine Teilnahme aus der Ferne vorgesehen."
msgstr "This type of meeting does not provide for remote participation."

msgid "Organisationsmitglieder trägt die Leitung mit ihrem Vertreter ein."
msgstr "Organisation members are entered by the chair together with their representative."

msgid "Aus der Ferne teilnehmen können nur Stimmberechtigte."
msgstr "Only members entitled to vote can take part remotely."

msgid "Bei dieser Art ist keine Online-Abstimmung vorgesehen."
msgstr "This type of meeting does not provide for online voting."

msgid "Abstimmungen sind jetzt nicht mehr möglich."
msgstr "Votes are no longer possible."

msgid "Zu viele Abstimmungen in dieser Versammlung."
msgstr "Too many votes in this meeting."

msgid "Zu viele Personen zur Wahl."
msgstr "Too many candidates."

msgid "Bitte mindestens eine Person zur Wahl angeben."
msgstr "Please enter at least one candidate."

msgid "Die Abstimmung wurde schon gestartet."
msgstr "The vote has already been started."

msgid "Die Abstimmung läuft nicht."
msgstr "The vote is not running."

msgid "Unbekannter Stand."
msgstr "Unknown status."

msgid "Bitte eine Antwort wählen."
msgstr "Please choose an answer."

msgid "Für diese Stimme bist du nicht berechtigt."
msgstr "You are not entitled to cast this vote."

msgid "Für diese Stimme wurde schon abgestimmt."
msgstr "This vote has already been cast."

msgid "Die Abstimmung ist noch nicht beendet."
msgstr "The vote has not ended yet."

msgid "Das Protokoll lässt sich nicht mehr ändern."
msgstr "The minutes can no longer be changed."

msgid "Anmeldung per App"
msgstr "Check-in via app"

msgid "beendet"
msgstr "ended"

msgid "Teilnahme aus der Ferne"
msgstr "Remote participation"

msgid "erlaubt"
msgstr "allowed"

msgid "nicht erlaubt"
msgstr "not allowed"

msgid "Abgestimmt wird nur bei Beschlüssen und Wahlen."
msgstr "Votes are only held for resolutions and elections."

msgid "Online-Abstimmung"
msgstr "Online vote"

msgid "gestartet"
msgstr "started"

msgid "Eine gestartete Abstimmung lässt sich nicht löschen."
msgstr "A vote that has been started cannot be deleted."

msgid "Online-Abstimmung erlaubt"
msgstr "Online voting allowed"

msgid "Teilnahme aus der Ferne erlaubt"
msgstr "Remote participation allowed"

msgid "gegangen"
msgstr "left"

msgid "per App"
msgstr "via app"

msgid "aus der Ferne"
msgstr "remote"

msgid "vorbereitet"
msgstr "prepared"

msgid "geheim"
msgstr "secret"

msgid "Die Anmeldung ist nicht geöffnet."
msgstr "Check-in is not open."

msgid "Bei dieser Versammlung ist keine Teilnahme aus der Ferne vorgesehen."
msgstr "This meeting does not provide for remote participation."

msgid "Der Code ist abgelaufen. Bitte den aktuellen Code scannen."
msgstr "The code has expired. Please scan the current code."

msgid "Online-Abstimmungen in Versammlungen (das Ergebnis steht im Beschluss)"
msgstr "Online votes in meetings (the result is recorded in the resolution)"

msgid "Kopfbild für schmale Bildschirme"
msgstr "Header image for narrow screens"

msgid ""
"Bildnummer eines Kopfbilds für Handys (unter 600 px Breite) oder null "
"(überall das Kopfbild)."
msgstr ""
"Image number of a header image for phones (below 600 px wide) or null "
"(header image everywhere)."

msgid "Bitte die Zeilen als Liste senden."
msgstr "Please send the lines as a list."

msgid "Höchstens {n} Zeilen je Haushaltsplan."
msgstr "At most {n} lines per budget."

msgid "Ungültige Zeile."
msgstr "Invalid line."

msgid "Bitte Einnahmen oder Ausgaben wählen."
msgstr "Please choose income or expenses."

msgid "Die Kategorie „{name}“ passt nicht zu {kind}."
msgstr "The category “{name}” does not match {kind}."

msgid "Bitte einen Betrag von 0 oder mehr eingeben."
msgstr "Please enter an amount of 0 or more."

msgid "Diese Kategorie steht schon im Plan."
msgstr "This category is already in the budget."

msgid "Der Haushaltsplan wurde inzwischen geändert. Bitte neu laden."
msgstr "The budget has been changed in the meantime. Please reload."

msgid ""
"Der Haushaltsplan ist beschlossen. Zum Ändern bitte zuerst wieder auf Entwurf"
" setzen."
msgstr "The budget has been adopted. To change it, set it back to draft first."

msgid "Für das Vorjahr gibt es keinen Plan."
msgstr "There is no budget for the previous year."

msgid "Im Vorjahr gibt es keine Buchungen."
msgstr "There are no bookings in the previous year."

msgid "Bitte Plan oder Ist wählen."
msgstr "Please choose plan or actual."

msgid "Für dieses Jahr gibt es noch keinen Plan."
msgstr "There is no budget for this year yet."

msgid "Bitte das Datum des Beschlusses angeben."
msgstr "Please enter the date of the resolution."

msgid "Der Plan hat noch keine Zeilen."
msgstr "The budget has no lines yet."

msgid "Bitte Entwurf oder beschlossen wählen."
msgstr "Please choose draft or adopted."

msgid "Plan {year}"
msgstr "Plan {year}"

msgid "Ist {year}"
msgstr "Actual {year}"

msgid "Hochrechnung"
msgstr "Forecast"

msgid "nicht geplant"
msgstr "not budgeted"

msgid "Haushaltsplan {year}"
msgstr "Budget {year}"

msgid "beschlossen am {date}"
msgstr "adopted on {date}"

msgid "Geschäftsjahr {start} bis {end}"
msgstr "Financial year {start} to {end}"

msgid "Stand {date}"
msgstr "As of {date}"

msgid "Summe"
msgstr "Total"

msgid "Einnahmen minus Ausgaben"
msgstr "Income minus expenses"

msgid "Ungültige Anfrage."
msgstr "Invalid request."

msgid "beschlossen"
msgstr "adopted"

msgid "Diesen Menüpunkt kann man nicht in den Fuß setzen."
msgstr "This menu item cannot be placed in the footer."

msgid "Platz im Fuß: „fuss“, „beides“ oder „menue“."
msgstr "Place in the footer: “fuss” (footer only), “beides” (both) or “menue” (menu only)."

msgid ""
"Schlüssel eines Hauptpunkts → „fuss“ (nur im Fuß, z. B. Kontakt neben dem "
"Impressum), „beides“ (Menü und Fuß) oder „menue“ (nur im Menü)."
msgstr ""
"Key of a main item → “fuss” (footer only, e.g. contact next to the legal "
"notice), “beides” (menu and footer) or “menue” (menu only)."

msgid "Text im Entwurf (Markdown; Bilder als ![Beschreibung](bild:Schlüssel), siehe webseite_bilder). Textseiten haben „abschnitte“ wie die Startseite; ändern mit textseite_aufbau_aendern und textseite_abschnitt_aendern."
msgstr "Draft text (Markdown; images as ![description](bild:key), see webseite_bilder). Text pages have “abschnitte” (sections) like the home page; change them with textseite_aufbau_aendern and textseite_abschnitt_aendern."

msgid "Abschnitte gibt es nur auf Textseiten (nicht in der Chronik mit Zeitleiste)."
msgstr "Sections exist only on text pages (not in the chronicle with a timeline)."

msgid "Diesen Abschnitt gibt es nicht. Erst webseite_text_lesen aufrufen."
msgstr "This section does not exist. Call webseite_text_lesen first."

msgid "Den Text der Seite ändert webseite_text_aendern; er hat hier keinen Inhalt."
msgstr "The page text is changed with webseite_text_aendern; it has no content here."

msgid "Aufbau einer Textseite ändern (Entwurf)"
msgstr "Change the layout of a text page (draft)"

msgid "Abschnitte einer Textseite wie auf der Startseite: neue eigene Abschnitte (z. B. Kacheln, Text mit Bild, Knopfleiste, Ansprechpartner; dazu „cover“ = Titelbild mit inhalt {image}, höchstens eins), Reihenfolge, an/aus, Aussehen und Entfernen. Der Text der Seite ist der feste Abschnitt „body“ (ändern mit webseite_text_aendern). Schlüssel liefert webseite_text_lesen, Felder je Art startseite_bausteine."
msgstr "Sections of a text page as on the home page: new custom sections (e.g. tiles, text with image, button bar, contacts; plus “cover” = cover image with inhalt {image}, at most one), order, on/off, look and removal. The page text is the fixed section “body” (change it with webseite_text_aendern). Keys come from webseite_text_lesen, fields per kind from startseite_bausteine."

msgid "Abschnitt einer Textseite ändern (Entwurf)"
msgstr "Change a section of a text page (draft)"

msgid "Ändert den Inhalt eines eigenen Abschnitts einer Textseite im Entwurf. „inhalt“ enthält nur die geänderten Felder, aufgebaut wie „data“ aus webseite_text_lesen."
msgstr "Changes the content of a custom section of a text page in the draft. “inhalt” contains only the changed fields, structured like “data” from webseite_text_lesen."

msgid "Aufbau der Textseite „{title}“ geändert."
msgstr "Layout of the text page “{title}” changed."

msgid "Abschnitt {key} der Textseite geändert."
msgstr "Section {key} of the text page changed."

msgid "Nummer der Textseite."
msgstr "Number of the text page."

msgid "Schlüssel → {hintergrund, breite}, Werte aus startseite_bausteine. Auch für „body“, z. B. breite full für Text über die volle Breite."
msgstr "Key → {hintergrund, breite}, values from startseite_bausteine. Also for “body”, e.g. breite full for text across the full width."
