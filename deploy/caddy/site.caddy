# Gemeinsamer Inhalt beider Caddyfiles (direkt mit eigenem HTTPS oder hinter
# einem vorgeschalteten Webserver). Erwartet ein Snippet (upstream) für die
# Kopfzeilen an das Backend.
encode zstd gzip

# Nur für Caddy selbst (Zertifikatsabfrage, direkt im Docker-Netz), nie von außen
@intern path /api/intern/*
respond @intern 404

@backend path /api/* /_allauth/* /admin /admin/* /static/*
# Nur die Vollübernahme (Datenimport) braucht bis 500 MB (Gesamtaudit 31.10.b, INF-S02);
# alles andere höchstens 64 MB (Rundschreiben mit Anhängen, Verbundpakete bis 48 MB).
# So belegt kein anderer Pfad mit Riesenanfragen Speicher und Platte (Gesamtaudit 05.11. GA-09).
@grossupload path_regexp ^/api/(orgs/[0-9]+/|platform/)datatransfer/imports/$
@normalupload not path_regexp ^/api/(orgs/[0-9]+/|platform/)datatransfer/imports/$
handle @backend {
	request_body @grossupload {
		max_size 520MB
	}
	request_body @normalupload {
		max_size 64MB
	}
	reverse_proxy backend:8000 {
		import upstream
		# Startet das Backend neu (z. B. beim Ausrollen), wartet Caddy bis zu 30 s,
		# statt sofort mit 502 zu antworten. Wiederholt wird nur der Verbindungsaufbau;
		# eine Anfrage, die das Backend schon erreicht hat, wird nie doppelt gesendet.
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}

import media.caddy

# Vereinswebseite aus hubiplan-website (eigener Container „website“ im Netz „web“).
# Läuft er nicht, antwortet nur dieser Pfad mit einem Fehler.
redir /webseite /webseite/ 308
handle_path /webseite/* {
	reverse_proxy {$WEBSITE_UPSTREAM:website:8000} {
		import upstream
		# Beim Ausrollen der Webseite kurz warten statt Fehler
		lb_try_duration 15s
		lb_try_interval 250ms
	}
}

handle {
	# frame-src https:: Vorschau der Vereinswebseite im Rahmen (Webseite › Gestaltung); die
	# Webseite erlaubt das Einbetten nur HUBIplan und nur in der Vorschau (frame-ancestors)
	header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; frame-src 'self' blob: https:; object-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	root * /srv
	try_files {path} /index.html
	file_server
}

header {
	Strict-Transport-Security "max-age=15552000"
	# Kamera nur für HUBIplan selbst (Live-Kamera im Standmodus), nie für fremde Rahmen
	Permissions-Policy "camera=(self), microphone=(), geolocation=()"
	X-Content-Type-Options "nosniff"
	Referrer-Policy "strict-origin-when-cross-origin"
	-Server
}

# Ist das Backend oder die Webseite nicht erreichbar (z. B. beim Ausrollen), statt einer
# leeren Fehlerseite eine freundliche Seite, die sich selbst neu lädt. Die Oberfläche
# wiederholt Anfragen bei 503 ohnehin (frontend/src/api/client.ts). Antworten, die das
# Backend selbst mit einem Fehlercode schickt, bleiben unverändert.
handle_errors 502 503 504 {
	header Retry-After 5
	header Cache-Control no-store
	header Content-Type "text/html; charset=utf-8"
	respond `<!doctype html><html lang="de"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta http-equiv="refresh" content="5"><title>Wird aktualisiert</title></head><body style="font-family:system-ui,sans-serif;margin:0;background:#f6f7f9;color:#1f2933"><main style="max-width:32rem;margin:15vh auto;padding:2rem;text-align:center"><h1 style="font-size:1.4rem">HUBIplan wird gerade aktualisiert</h1><p>Das dauert meist nur einen Moment. Die Seite lädt in wenigen Sekunden von selbst neu.</p></main></body></html>` 503
}
