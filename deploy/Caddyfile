# Webserver mit eigenem HTTPS (Let's Encrypt, automatisch), z. B. Testserver:
# ausgeliefertes React-Frontend und Weiterleitung der API ans Django-Backend.
# Hinter einem vorgeschalteten Webserver gilt stattdessen Caddyfile.proxy.

{
	# Beim Beenden (Ausrollen) höchstens 3 s auf laufende Anfragen warten. Ohne Frist wartet
	# Caddy auf jede offene Anfrage, bis Docker nach 10 s abbricht; beim Messen auf dem
	# Testserver (08.11.2026) hing eine Anfrage beim Caddy-Tausch so 19,6 s.
	grace_period 3s
	# Zertifikate für weitere Adressen (W7c, siehe unten) nur nach Rückfrage beim Backend
	on_demand_tls {
		ask http://backend:8000/api/intern/tls/
	}
}

# Caddy ist der einzige Proxy vor dem Backend und setzt X-Forwarded-For selbst
# (verwirft, was der Aufrufer mitschickt). Hier nur zur Klarheit ausgeschrieben.
(upstream) {
	header_up X-Forwarded-Proto {http.request.scheme}
}

{$SITE_HOST} {
	import caddy/site.caddy
}

# Weitere Adressen aus „Adressen je Einheit“ (White Label W7c): Zertifikate holt Caddy erst
# beim ersten Aufruf, und nur wenn das Backend die Adresse in seiner Liste hat. Ohne
# HUBIPLAN_ADRESSEN_AUS_LISTE=1 lehnt das Backend jede Anfrage ab, es gibt also kein Zertifikat.
https:// {
	tls {
		on_demand
	}
	import caddy/site.caddy
}

# Nur im Docker-Netz „web“ (kein Port nach außen): Die Vereinswebseite holt Logos und
# Bilder hier ab (HUBIPLAN_MEDIA_URL=http://web:8081). Über die eigene öffentliche
# Adresse erreicht ihr Container den Server nicht (UX-Audit 31.10. R02).
:8081 {
	import caddy/media.caddy
	respond 404
}
