# Vorlage für die .env auf dem Testserver (liegt dort neben docker-compose.server.yml).
# deploy/server-setup.sh legt sie beim ersten Ausrollen automatisch mit
# zufälligen Geheimnissen an. NIEMALS echte Werte ins Repository einchecken.

# Hostname, unter dem der Server erreichbar ist (Let's Encrypt holt dafür das Zertifikat)
SITE_HOST=hubiplan.example.org

# Hinter einem vorhandenen Webserver (Echtserver mit HestiaCP, docs/echtbetrieb.md):
# Caddy nur auf 127.0.0.1:WEB_PORT, HTTPS macht der vorgeschaltete Webserver.
# HUBIPLAN_HINTER_PROXY=1
# WEB_PORT=8110
# Name in Authenticator-Apps (Standard: "HUBIplan (Test)")
# MFA_TOTP_ISSUER=HUBIplan

# Langer Zufallswert, z. B.: openssl rand -base64 48
DJANGO_SECRET_KEY=bitte-aendern

# Passwort der PostgreSQL-Datenbank (wird nur beim allerersten Start übernommen)
POSTGRES_PASSWORD=bitte-aendern

# Passwort für Redis (wird beim Ausrollen erzeugt). Programme auf demselben
# Server könnten das Docker-Netz sonst ohne Anmeldung erreichen.
REDIS_PASSWORD=bitte-aendern

# Passphrase für die verschlüsselten Backups (wird beim Ausrollen erzeugt).
# UNBEDINGT zusätzlich sicher verwahren (Passwortmanager) – ohne sie sind die
# Backups wertlos.
BACKUP_PASSPHRASE=bitte-aendern
# Schlüssel für die Prüfsummen (HMAC) der Backups (wird beim Ausrollen erzeugt).
# Ebenfalls sicher verwahren: ohne ihn lassen sich neue Backups nicht prüfen.
BACKUP_HMAC_KEY=bitte-aendern

# Schlüssel für die 2FA-Geheimnisse in der Datenbank (Fernet, wird beim Ausrollen
# erzeugt). Liegt bewusst nicht im Backup. UNBEDINGT sicher verwahren: ohne ihn
# funktionieren nach einer Rücksicherung keine Authenticator-Apps und
# Wiederherstellungscodes mehr. Schlüsselwechsel: MFA_ENCRYPTION_KEYS=neu,alt
MFA_ENCRYPTION_KEY=bitte-aendern
# Hauptschlüssel der Datenverschlüsselung: eigene Datei, nicht hier (legt
# deploy/server-setup.sh an; siehe docs/betrieb.md, Abschnitt Verschlüsselung)
# DATA_KEY_FILE=/opt/hubiplan-geheim/datenschluessel
# BACKUP_TIME=03:15
# BACKUP_KEEP_DAYS=30
# BACKUP_DIR=/opt/hubiplan-backups
# Optional: Kopie an einen zweiten Ort (rsync über SSH), z. B. backup@host:/pfad/
# BACKUP_REMOTE=

# E-Mail-Versand per SMTP (sonst landen Mails als Dateien auf dem Server)
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=HUBIplan <noreply@example.org>

# Wählbare Sprachen der Oberfläche (Deutsch ist immer dabei), z. B. zum Testen: de,en
# HUBIPLAN_LANGUAGES=de

# Täglich prüfen, ob es ein neueres HUBIplan-Release gibt (Hinweis für Plattformverwalter).
# GitHub sieht dabei nur die IP-Adresse des Servers. Abschalten mit 0.
# HUBIPLAN_UPDATE_CHECK=1

# Selbstupdate (docs/betrieb.md, „Selbstupdate“): Plattformverwalter stoßen ein neues Release
# per Knopf an, ein Dienst auf dem Server rollt es aus (nur signierte Release-Tags, vorher
# Sicherung, bei Fehler zurück). Braucht systemd, git und ssh-keygen. Standard: aus.
# HUBIPLAN_SELBSTUPDATE=1
# AKTUALISIERUNG_DIR=/opt/hubiplan-aktualisierung
# HUBIPLAN_UPDATE_REPO=https://github.com/hubiplan/hubiplan.git

# Google Wallet: optional, siehe docs/wallet.md (Pfad innerhalb des Containers)
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CREDENTIALS_FILE=
GOOGLE_WALLET_LOGO_URL=


# Apple Wallet: optionaler pkpass-Download, siehe docs/wallet.md
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_CERTIFICATE_FILE=
APPLE_WALLET_CERTIFICATE_PASSWORD=
APPLE_WALLET_WWDR_FILE=
