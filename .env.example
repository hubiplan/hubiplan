# Vorlage für die lokale Konfiguration.
# Kopieren nach .env und anpassen. Die .env-Datei wird NICHT eingecheckt.
# Ohne .env gelten die Standardwerte aus docker-compose.yml.

# --- Django ---
DJANGO_DEBUG=true
# Für jeden Server einen eigenen, langen Zufallswert erzeugen, z. B. mit:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=bitte-aendern
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# --- Google Wallet (optional, Einrichtung: docs/wallet.md) ---
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CREDENTIALS_FILE=
GOOGLE_WALLET_LOGO_URL=

# --- PostgreSQL (Docker-Container) ---
POSTGRES_DB=hubiplan
POSTGRES_USER=hubiplan
POSTGRES_PASSWORD=bitte-aendern

# Nur für die lokale Entwicklung ohne Docker (Backend direkt auf dem Rechner):
# DATABASE_URL=postgres://hubiplan:bitte-aendern@localhost:5432/hubiplan
# REDIS_URL=redis://localhost:6379/0

# Apple Wallet: optionaler pkpass-Download, siehe docs/wallet.md
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_CERTIFICATE_FILE=
APPLE_WALLET_CERTIFICATE_PASSWORD=
APPLE_WALLET_WWDR_FILE=
