    "/api/partner/v1/events/": {
      "get": {
        "description": "Eigene Termine der Einheit und ihrer Untereinheiten als Einzeltermine, Serien aufgelöst, nach Beginn sortiert. Ohne den Bereich „termine.mitglieder“ nur öffentliche Termine. Nie enthalten: Termine „nur Vorstand“, Zu- und Absagen, Teilnehmende, Anhänge, übernommene fremde Termine.",
        "operationId": "events",
        "parameters": [
          {
            "description": "nur Termine, die seitdem geändert wurden",
            "in": "query",
            "name": "changed_since",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "``next_cursor`` der Seite davor",
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            }
          },
          {
            "description": "Vorgabe: vor 30 Tagen",
            "in": "query",
            "name": "from",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "1 bis 200, Vorgabe 100",
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Vorgabe: in 365 Tagen",
            "in": "query",
            "name": "to",
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "description": "nur diese Untereinheit und die darunter",
            "in": "query",
            "name": "unit",
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventList"
                }
              }
            },
            "description": ""
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": ""
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": ""
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": ""
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": ""
          }
        },
        "security": [
          {
            "apiKey": []
          }
        ],
        "summary": "Termine",
        "tags": [
          "events"
        ]
      }
    },
