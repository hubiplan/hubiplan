    "/api/partner/v1/statistics/census/": {
      "get": {
        "description": "Anzahlen nach Altersgruppe und Geschlecht, dazu je Untereinheit bzw. Verein. Nur Zahlen, keine Personen und keine Wohnorte. ``counts`` und ``genders`` folgen der Reihenfolge von ``gender_labels``.",
        "operationId": "statistics_census",
        "parameters": [
          {
            "description": "Altersgruppen",
            "in": "query",
            "name": "ages",
            "schema": {
              "enum": [
                "jugend",
                "sport",
                "zehn"
              ],
              "type": "string"
            }
          },
          {
            "description": "Alter am Stichtag oder nach Jahrgang",
            "in": "query",
            "name": "counting",
            "schema": {
              "enum": [
